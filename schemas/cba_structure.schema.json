{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/glen-w/hoops/schemas/cba_structure.schema.json",
  "title": "NBA CBA Structure Schema",
  "description": "Schema for NBA Collective Bargaining Agreement structure metadata (no fulltext)",
  "type": "object",
  "required": ["edition", "source_sha256", "generated_at", "units"],
  "properties": {
    "edition": {
      "type": "string",
      "description": "CBA edition year (e.g., '2017', '2023')",
      "pattern": "^(2017|2023)$"
    },
    "source_sha256": {
      "type": "string",
      "description": "SHA-256 hash of source PDF",
      "pattern": "^[a-f0-9]{64}$"
    },
    "source_url": {
      "type": "string",
      "description": "Official source URL (NBPA or NBA)"
    },
    "generated_at": {
      "type": "string",
      "description": "ISO 8601 timestamp of structure extraction",
      "format": "date-time"
    },
    "units": {
      "type": "array",
      "description": "Hierarchical structural units (articles, sections, exhibits)",
      "items": {
        "type": "object",
        "required": ["id", "type", "title"],
        "properties": {
          "id": {
            "type": "string",
            "description": "Unique identifier (e.g., 'article_1', 'section_1_1', 'exhibit_a')"
          },
          "type": {
            "type": "string",
            "description": "Unit type",
            "enum": ["article", "section", "subsection", "exhibit", "appendix"]
          },
          "title": {
            "type": "string",
            "description": "Unit title (truncated if needed)"
          },
          "parent_id": {
            "type": ["string", "null"],
            "description": "ID of parent unit (null for top-level)"
          },
          "page_start": {
            "type": ["integer", "null"],
            "description": "Starting page number (1-indexed)"
          },
          "page_end": {
            "type": ["integer", "null"],
            "description": "Ending page number (inclusive)"
          },
          "char_offset_start": {
            "type": ["integer", "null"],
            "description": "Character offset in extracted fulltext"
          },
          "char_offset_end": {
            "type": ["integer", "null"],
            "description": "Character offset end in extracted fulltext"
          },
          "text_sha256": {
            "type": ["string", "null"],
            "description": "SHA-256 hash of unit's fulltext content (not stored in repo)",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
